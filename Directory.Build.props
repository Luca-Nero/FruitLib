<Project>

  <!-- ModRefs sits beside the repo in CI (workspace/main + workspace/ModRefs)
       and two levels up in the monorepo (Frukt/Mods/<mod> + Frukt/ModRefs).
       Probe CI's layout first, then the local one. -->
  <PropertyGroup>
    <ModRefsDir Condition="'$(ModRefsDir)' == '' And Exists('$(MSBuildThisFileDirectory)..\ModRefs')">$(MSBuildThisFileDirectory)..\ModRefs\</ModRefsDir>
    <ModRefsDir Condition="'$(ModRefsDir)' == '' And Exists('$(MSBuildThisFileDirectory)..\..\ModRefs')">$(MSBuildThisFileDirectory)..\..\ModRefs\</ModRefsDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(ModRefsDir)0Harmony.dll</HintPath>
